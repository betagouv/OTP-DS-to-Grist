{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "📦 Installation complète",
      "type": "shell",
      "command": "echo \"📦 Installation des dépendances Python...\" && poetry install --with dev && echo \"✅ Dépendances Python installées\" && echo \"\" && echo \"📦 Installation des dépendances JavaScript...\" && npm install && echo \"✅ Dépendances JavaScript installées\"",
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "🧪 Tests Python",
      "type": "shell",
      "command": "poetry run pytest",
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "🧪 Tests JS",
      "type": "shell",
      "command": "npm test",
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "🚀 App (live)",
      "type": "shell",
      "command": "if curl -sf http://localhost:5000/ >/dev/null 2>&1; then echo '✅ App déjà démarrée (port 5000)'; else exec poetry run python app.py; fi",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "npm: lint",
      "type": "npm",
      "script": "lint",
      "options": {
        "statusbar": {
          "hide": true
        }
      }
    },
    {
      "label": "npm: lint:fix",
      "type": "npm",
      "script": "lint:fix",
      "options": {
        "statusbar": {
          "hide": true
        }
      }
    },
    {
      "label": "npm: test",
      "type": "npm",
      "script": "test",
      "options": {
        "statusbar": {
          "hide": true
        }
      }
    }
  ]
}
